{
  "name": "nanoodle-mcp",
  "version": "0.7.0",
  "mcpName": "io.github.nanoodlecom/nanoodle-mcp",
  "description": "MCP server (stdio and HTTP) that runs nanoodle workflow graphs, saved or composed by the agent, as tools on the NanoGPT API: BYOK, pay per call in Nano (x402), or pay in native NEAR with automatic refunds",
  "type": "module",
  "bin": {
    "nanoodle-mcp": "bin/nanoodle-mcp.mjs"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "scripts": {
    "test": "node --test",
    "simulate:near": "node scripts/near-simulate.mjs",
    "simulate:dual": "node scripts/dual-simulate.mjs",
    "simulate:market": "node scripts/market-simulate.mjs",
    "build:near-wallet": "esbuild src/near-pay-browser.mjs --bundle --platform=browser --target=es2022 --format=esm --minify --outfile=assets/near-wallet.js --banner:js=\"/*! Includes NEAR Connect 0.12.0, MIT, HOT Labs. See /near-wallet.LICENSE.txt */\""
  },
  "files": [
    "src",
    "bin",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "nanocurrency": "^2.5.0",
    "nanoodle": "file:vendor/nanoodle-0.9.0-content-url.tgz"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "nanoodle",
    "workflow",
    "ai",
    "nanogpt",
    "image-generation",
    "video-generation",
    "llm",
    "agent",
    "tools",
    "byok",
    "x402",
    "nano",
    "accountless",
    "micropayments",
    "near",
    "near-protocol",
    "agent-payments",
    "pay-per-call",
    "custom-workflows"
  ],
  "license": "MIT",
  "author": "255BITS",
  "homepage": "https://nanoodle.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nanoodlecom/nanoodle-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/nanoodlecom/nanoodle-mcp/issues"
  },
  "devDependencies": {
    "@hot-labs/near-connect": "0.12.0",
    "esbuild": "0.28.2"
  }
}
