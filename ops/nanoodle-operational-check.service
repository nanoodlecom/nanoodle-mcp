[Unit]
Description=Read-only Nanoodle payment and workflow readiness
Wants=network-online.target
After=network-online.target nanoodle-mcp.service
OnFailure=nanoodle-near-alert@%n.service

[Service]
Type=oneshot
User=nanoodle-mcp
Group=nanoodle-mcp
WorkingDirectory=/srv/nanoodle-mcp/app
EnvironmentFile=/etc/nanoodle-mcp/env
EnvironmentFile=/etc/255labs/system-trust.env
StateDirectory=nanoodle-operational-check
StateDirectoryMode=0755
UMask=0077
ExecStart=/usr/bin/flock -n /var/lib/nanoodle-operational-check/check.lock /usr/local/bin/with-system-trust /opt/node-v22.23.4-linux-x64/bin/node /srv/nanoodle-mcp/app/scripts/operational-check.mjs
TimeoutStartSec=4min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/srv/nanoodle-mcp/out
ProtectHome=true
InaccessiblePaths=/etc/nanoodle-near-check
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
