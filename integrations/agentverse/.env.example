# Copy to .env locally or export in your shell. NEVER commit a filled copy.
# The agent is inactive until NANOODLE_AGENTVERSE_ENABLED=1.

NANOODLE_AGENTVERSE_ENABLED=0

# Agent identity seed phrase. Generate offline, store in a secret store.
# Placeholder values are rejected at startup.
NANOODLE_AGENTVERSE_SEED=

# Only needed for scripted Agentverse API calls / registration tooling.
AGENTVERSE_API_KEY=

# MCP endpoint to run workflows on. Default is the hosted pay-per-call
# endpoint; point at your own `nanoodle-mcp --serve` instance for
# operator-funded (BYOK / free-serve) execution and free previews.
NANOODLE_MCP_URL=https://mcp.nanoodle.com/mcp

# Optional allowlist + free-preview workflows (comma-separated tool names).
NANOODLE_AGENTVERSE_WORKFLOWS=
NANOODLE_AGENTVERSE_FREE_WORKFLOWS=

# Optional: workflow that plain natural-language messages run against
# (ASI:One sends conversational prompts, not commands). Leave unset to
# answer non-commands with usage instructions instead. Every such
# message spends a run — opt in deliberately.
NANOODLE_AGENTVERSE_DEFAULT_WORKFLOW=

NANOODLE_AGENTVERSE_PORT=8001
